{
  "name": "@jswork/antd-form-schema-crud",
  "version": "1.0.0",
  "description": "Ant Design resource CRUD driven by antd-form-schema and show/create/update/destroy APIs.",
  "homepage": "https://js.work",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter example dev",
    "docs": "node scripts/markdown.js",
    "test": "pnpm --filter @jswork/antd-form-schema-crud test",
    "build": "pnpm run docs && pnpm --filter @jswork/antd-form-schema-crud build",
    "release": "pnpm --filter @jswork/antd-form-schema-crud release"
  },
  "devDependencies": {
    "@jswork/next": "^1.2.2",
    "@jswork/next-replace-in-file": "^1.0.0",
    "indent-string": "^5.0.0"
  }
}
